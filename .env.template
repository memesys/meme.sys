# Required: Telegram Bot Token from @BotFather
TG_BOT_TOKEN=your_telegram_bot_token_here

# Required: OpenAI API Key for image description
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Database URI (defaults to SQLite)
# For PostgreSQL use: postgresql://user:password@host:port/dbname
# For SQLite use: sqlite:///memes.db
DATABASE_URI=sqlite:///memes.db
